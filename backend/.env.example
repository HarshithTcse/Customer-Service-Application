PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/customer_service_db
JWT_SECRET=yoursecretjwtkeyhere
NODE_ENV=development

# Optional SMTP Configuration (If left blank, Ethereal test account is created dynamically)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Razorpay Test Configuration (Sandbox mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
